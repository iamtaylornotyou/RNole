profiles {
    docker {
        docker.enabled = true
    }
}

process {
    resourceLimits = [
        cpus: 8,
        memory: 14.GB,
        time: 24.h
    ]

    withName: 'RUN_ORTHOFINDER' {
        container = 'davidemms/orthofinder'
    }
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}